# Pixel AI Instagram Bot Configuration
# Copy this file to .env and fill in your values

# Instagram Login Credentials
PIXEL_INSTAGRAM_USERNAME=your_instagram_username
PIXEL_INSTAGRAM_PASSWORD=your_instagram_password

# Optional: Restrict bot to only respond to one user (your own ID)
# Get your user ID from: https://instagram.com/username/?__a=1
PIXEL_OWNER_ID=your_user_id_here

# Session file (optional - defaults to pixel_session.json)
PIXEL_SESSION_FILE=pixel_session.json

# Rate limiting (seconds between actions)
PIXEL_RATE_LIMIT_DELAY=30
PIXEL_ACTION_DELAY=5