# Haki Chatbot Configuration

# ============================================
# LLM REASONING ENGINE
# ALL configured providers stay active. The engine rotates across every key
# (round-robin by default) with retry + failure-weighting + cascade, so no
# key sits unused. Configure at least ONE key or the bot uses rule-based
# fallback.
#
# Routing modes:
#   round-robin (default) — alternates across all active keys
#   priority              — always try NVIDIA → Groq → Google (first key that works)
#   favorite              — prefer a specific provider via LLM_FAVORITE_PROVIDER
# Per-message override: context.llm = { provider: 'google', mode: 'priority' }
# ============================================

# Option 1: NVIDIA NIM (free key: https://build.nvidia.com)
LLM_API_KEY=your-nvidia-api-key-here
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=meta/llama-3.1-8b-instruct

# Option 2: Groq (free key: https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# Option 3: Google AI Studio (free key: https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_MODEL=gemini-flash-latest

# Optional routing control
# LLM_ROUTING=round-robin
# LLM_FAVORITE_PROVIDER=nvidia

# ============================================
# VOICE NOTES (Optional)
# Transcribes voice messages via OpenAI Whisper API.
# Requires ffmpeg on the host (bundled in Docker image).
# ============================================
# WHISPER_API_KEY=your-openai-api-key

# ============================================
# BOT SETTINGS
# ============================================
BOT_NAME=Haki
BOT_VERSION=1.0.0
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=sw,en
LOG_LEVEL=info
HEALTH_PORT=3001