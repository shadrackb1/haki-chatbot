# Haki Chatbot Configuration

# ============================================
# LLM REASONING ENGINE (Optional but Recommended)
# Get your free API key from: https://build.nvidia.com
# ============================================
LLM_API_KEY=your-nvidia-api-key-here
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=nvidia/stepfun-ai/step-3.7-flash

# Alternative: Use OpenAI
# LLM_API_KEY=your-openai-api-key
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# Alternative: Use OpenRouter (has free tier)
# LLM_API_KEY=your-openrouter-api-key
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=meta-llama/llama-4-maverick:free

# ============================================
# BOT SETTINGS
# ============================================
BOT_NAME=Haki
BOT_VERSION=1.0.0
DEFAULT_LANGUAGE=sw
SUPPORTED_LANGUAGES=sw,en
LOG_LEVEL=info