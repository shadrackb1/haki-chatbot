# Haki Chatbot Configuration

# ============================================
# LLM REASONING ENGINE
# ALL configured providers stay active. The engine rotates across every key
# (round-robin by default) with retry + failure-weighting + cascade, so no
# key sits unused. Configure at least ONE key or the bot uses rule-based
# fallback.
#
# Routing modes:
#   round-robin (default) — alternates across all active keys
#   priority              — always try NVIDIA → Groq → Google (first key that works)
#   favorite              — prefer a specific provider via LLM_FAVORITE_PROVIDER
# Per-message override: context.llm = { provider: 'google', mode: 'priority' }
# ============================================

# Option 1: NVIDIA NIM (free key: https://build.nvidia.com)
LLM_API_KEY=your-nvidia-api-key-here
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=meta/llama-3.1-8b-instruct

# Option 2: Groq (free key: https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# Option 3: Google AI Studio (free key: https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_MODEL=gemini-flash-latest

# Optional routing control
# LLM_ROUTING=round-robin
# LLM_FAVORITE_PROVIDER=nvidia
#
# Tier plans (auto-selected by the grievance pipeline):
#   research → Gemini deep reasoning (critical: SAFETY/HARASSMENT)
#   analysis → DeepSeek-R1 family for legal dig-downs
#   fast     → cheapest/fastest for lightweight calls
# GOOGLE_REASONING_MODEL=gemini-flash-latest
# GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b
# LLM_REASONING_MODEL=deepseek-ai/deepseek-r1
# GROQ_FAST_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=meta/llama-3.1-8b-instruct

# ============================================
# SEMANTIC RAG (Optional but free)
# Hybrid retrieval = BM25 + dense vectors fused with Reciprocal Rank Fusion.
# Uses whichever keys are configured; degrades to BM25-only when absent.
# ============================================
# NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
# NVIDIA_EMBED_MODEL=nvidia/nv-embed-v1
# GOOGLE_EMBED_MODEL=text-embedding-004

# ============================================
# TRANSLATION (Gemini — set GOOGLE_API_KEY)
# Worker messages in any of ~26 languages are translated to English for
# accurate legal analysis, then the reply is translated back. Rule-based
# fallback keeps original text when the API is unavailable.
# ============================================
# GOOGLE_TRANSLATE_MODEL=gemini-flash-latest

# ============================================
# VOICE NOTES (default: Google Gemini audio when GOOGLE_API_KEY is set)
# Priority: OpenAI Whisper → Google Gemini audio → Groq Whisper.
# Gemini understands OGG/OPUS natively — no ffmpeg needed for that path.
# Requires ffmpeg on the host only for the Whisper paths.
# ============================================
# WHISPER_API_KEY=your-openai-api-key
# GOOGLE_AUDIO_MODEL=gemini-2.0-flash
# GROQ_WHISPER_MODEL=whisper-large-v3

# ============================================
# VISION / VIDEO (Gemini — set GOOGLE_API_KEY)
# Photos and workplace video clips. Clips over ~18MB are sampled to key
# frames via ffmpeg (falls back to a friendly error if ffmpeg is missing).
# ============================================
# GEMINI_VISION_MODEL=gemini-flash-latest

# ============================================
# SMS CHANNEL (optional but free)
# Default "simulator" needs nothing — post {from,text} JSON to
# POST /sms on the health server for a live web console.
# Real providers are self-hosted and fee-free:
#   SMS_PROVIDER=textbee  (REST; Android phone as modem)
#   SMS_PROVIDER=gammu    (SMSD; GSM modem over CLI/filesystem)
# ============================================
SMS_PROVIDER=simulator
# SMS_SHORTCODE=22141
# TEXTBEE_URL=http://localhost:8080
# TEXTBEE_API_KEY=
# TEXTBEE_CHANNEL=gateway
# TEXTBEE_SIMULATOR=false
# GAMMU_BIN=gammu-smsd-inject
# GAMMU_INBOX_DIR=
# GAMMU_POLL_MS=2000

# ============================================
# CASE STORE + SLA ESCALATION
# Every serious grievance opens a tracked case (data/cases.json) with an
# SLA deadline. Overdue IN_REVIEW cases auto-escalate and notify CSOs.
#   crisis   → 2h    safety/harassment → 24h
#   wage/contract/child/environment/land → 72h
# ============================================
# CSO_CONTACTS=+254700000000,+254722222222
# CASE_DB_PATH=./data/cases.json

# ============================================
# CORPORATE HRDD DASHBOARD (live, self-hosted)
# Anonymized KPIs, county hotspots, case queue, SLA/escalation view and
# a live SMS console. Chart assets are inline — no CDN required.
# ============================================
# DASHBOARD_PORT=3003

# ============================================
# BOT SETTINGS
# ============================================
BOT_NAME=Haki
BOT_VERSION=1.0.0
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=sw,en
LOG_LEVEL=info
HEALTH_PORT=3001