# ============================================
# PIXEL AI — Dockerfile
# Personal AI Assistant WhatsApp Bot
# ============================================
FROM node:20-alpine

RUN apk add --no-cache ffmpeg

WORKDIR /app

COPY PixelAI/package.json PixelAI/package-lock.json ./
RUN npm ci --omit=dev

COPY PixelAI/src/ ./src/
COPY PixelAI/docs/ ./docs/

RUN mkdir -p auth_info data/media data/knowledge-base

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1

ENV NODE_ENV=production
CMD ["node", "src/index.js"]
